    "history": "^5.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.66.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
